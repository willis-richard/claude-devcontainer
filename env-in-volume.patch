   exit 1
 fi
-if [ -z "${IMAGE_CUDA_VERSION:-}" ] && [ $gpu = yes ]; then
-  echo "ERROR: GPU visible but this is a CPU image. Run up.sh --rebuild." >&2
+if [ -z "$cuda" ] && [ $gpu = yes ]; then
